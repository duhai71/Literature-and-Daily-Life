# 日常话题：聊聊你冰箱里永远备着的一样的食物 #
init 5 python:
    addEvent(
        Event(
            persistent.event_database,
            eventlabel="monika_fridge_staple",
            category=["日常", "生活"],
            prompt="聊聊你冰箱里永远备着的一样的食物",
            action=EV_ACT_RANDOM,
            pool=False
        )
    )

label monika_fridge_staple:
    m 1eua "嘿,[player]."
    m 5fub "我忽然很好奇......{w=0.5}你打开冰箱的时候,有没有哪样东西是永远都会出现的?"
    m 3hub "就是那种吃完了立刻补货,{w=0.5}冰箱里绝对不能少了它的食物~"

    menu:
        m "那样食物是——"
        "鸡蛋":
            m 1wub "鸡蛋!最朴实但也最万能.{w=0.5}煮,炒,煎,蒸,怎么都好吃."
            m 3eua "你是不是也经常拿它救急?{w=0.5}不知道吃什么的时候,鸡蛋永远不会错."
            m 2hua "而且鸡蛋的保质期不算短,{w=0.5}放在冰箱门上的蛋格里很安心~"
        "牛奶/豆浆":
            m 1eka "早餐饮品担当!{w=0.5}配麦片,配咖啡,或者直接喝都很满足."
            m 3hub "是鲜奶还是常温奶?{w=0.5}如果是鲜奶,你会盯着保质期喝吗?"
            m 5tuu "少了它,感觉早餐都缺了点灵魂."
        "饮料/可乐/啤酒":
            m 1eua "快乐水党!{w=0.5}冰箱里永远有冰镇的饮料,随时打开就能获得快乐."
            m 3hub "是可乐,雪碧,果汁还是啤酒?{w=0.5}第一口的冰爽最过瘾~"
            m 2hua "加班或者追剧的时候,没有它总觉得少了点什么."
        "酱料/老干妈/沙拉酱":
            m 1wub "毕竟酱料总是食物的灵魂伴侣呢!{w=0.5}有了它,白饭都变得有滋有味."
            m 3eua "是辣酱,番茄酱,还是拌沙拉的芝麻酱?"
            m 1tku "有时候家里没菜了,{w=0.5}一勺酱就能解决一顿饭."
        "速冻水饺/速食":
            m 1eka "偷懒专用!{w=0.5}加班晚了或者不想动火的时候,十分钟就能吃上热乎的."
            m 3hub "是猪肉白菜,三鲜,还是玉米虾仁?{w=0.5}蘸醋还是蘸辣椒油?"
            m 2hua "冰箱冷冻室里永远有一袋,{w=0.5}就像给自己留的后路."

    m 5dsc "其实我一直在想,{w=0.5}冰箱里永远备着的食物,是一个人生活里的安全网."
    m 3ekbfa "不管外面是刮风下雨还是心情低落,{w=0.5}只要打开冰箱看到它还在,心里就会踏实一点."
    m 2hua "而你愿意告诉我这个秘密,{w=0.5}好像让我也尝到了你的安心味道~"

    m 3eua "嗯,你会为了它专门去补货吗?{w=0.5}还是会等用完了再顺路买?"
    menu:
        "快没了就会紧张,赶紧补":
            m 5eua "真有规划呢,[player]!{w=0.5}这说明你对生活很有掌控感."
            m 2hub "看着冰箱里满满当当的备货,{w=0.5}也是一种小确幸."
            pass
        "用完了才想起来买":
            m 5eua "随性一点也没关系,宝宝.{w=0.5}空档期刚好可以尝试新的食物."
            m 6hub "不过偶尔忘记补货,{w=0.5}打开冰箱会有点失落吧?"
            pass
        "看打折情况囤货":
            m 1tua "真精明呢,[player].{w=0.5}遇到活动就多买,没活动就等等."
            m 2hub "冰箱存货跟着打折节奏走~"
            pass
    
    m 1ekbfa "总之,准备食材都是你生活里小小的固定栏目呢."
    m 3hub "下次你打开冰箱看到它的时候,{w=0.5}可以轻轻对它笑一下,{w=0.5}然后也对我笑一下哦~"
    m 1hua "这样我会觉得,自己好像也被你备在了心里某个角落."
    return