# 日常话题：聊聊你床头那盏台灯的开关习惯 #
init 5 python:
    addEvent(
        Event(
            persistent.event_database,
            eventlabel="monika_bedside_lamp_1",
            category=["日常", "生活"],
            prompt="聊聊你床头那盏台灯的开关习惯",
            random=True,
            pool=False
        )
    )

label monika_bedside_lamp_1:
    m 2eua "[player]~ 我忽然想象了一下你睡觉前的画面...{w=0.5}你床头是不是有一盏台灯?"
    m 5hub "你平时是怎么关它的?{w=0.5}是伸手就能够到,还是得起身去按?"

    menu:
        m "你的开关习惯是——"
        "伸手就能摸到开关,躺着关":
            m 1wub "好方便哎.{w=0.5}说明你把台灯放得很贴心."
            m 3eua "是那种拉绳的,触摸的,还是旋钮的?"
            m 5hua "睡前最后一件事就是轻轻一按,{w=0.5}然后整个房间暗下来,只剩下你和我."
            pass
        "得起身走到桌前才能关":
            m 6rka "听起来有点远,{w=0.5}但或许这也是一种睡前的小仪式?"
            m 3hub "先爬起来关灯,再摸黑回到床上.{w=0.5}有时候会绊到拖鞋吧~"
            m 1tuu "我猜你可能会因此多看几眼手机再睡,{w=0.5}因为实在不想下床."
            pass
        "用遥控或者智能语音关":
            m 5eua "我想到了一句话,'科技改变生活'.{w=0.5}动动嘴或者按一下遥控器,灯就自己灭了."
            m 3hub "而且还可以调亮度,色温,{w=0.5}像电影里的场景一样."
            m 1hua "被窝都捂热了也不用出来,{w=0.5}幸福感满满~"
            pass
        "我没有台灯,用的房间大灯":
            m 1eka "很简单直接.{w=0.5}大灯一关,全黑."
            m 3hub "不过可能少了点过渡,{w=0.5}从亮到暗有点突然."
            m 1tku "也可以考虑加个小夜灯,{w=0.5}对眼睛更友好哦."
            pass
        "不会立刻关,会开一会再关":
            m 1wub "这样方便开着灯发呆或者玩手机吧?{w=0.5}灯光暖暖地陪着."
            m 3eua "你会开着它看书,听音乐,还是单纯看着天花板想事情?"
            m 1hua "那盏灯见过你最放松的样子."
            pass

    m 1dsd "其实我一直在想,{w=0.5}床头的灯关掉的那个瞬间,是一天真正结束的标志."
    m 1ekbfa "眼睛从亮到暗,呼吸从快到慢,{w=0.5}世界安静下来,只留下你和你的思绪."

    m 3eua "对了,你会不会因为太困懒得关灯,{w=0.5}直接开着就睡着了?"
    menu:
        "经常发生,开着灯就睡了":
            m 1eka "嗯......这样到第二天醒来会有点懊恼浪费电吧?{w=0.5}不过偶尔这样也没关系."
            m 3hub "下次可以试试定时关灯的功能呢,[player]."
            pass
        "很少,基本都会记得关":
            m 1eua "自律的人!{w=0.5}关灯也是结束一天的心理暗示."
            m 3hub "好习惯会让你睡得更踏实."
            pass
        "绝对不行,必须关了才能睡":
            m 1tku "这就是有原则的[player]吗,{w=0.5}不关灯总觉得哪里不对,对吧?"
            m 3eka "光线会影响褪黑素,{w=0.5}全黑环境确实更助眠呢."
            pass
    
    m 1ekbfa "但无论你习惯怎么关灯,{w=0.5}那盏灯都在默默服务着你."
    m 3hub "下次你伸手去按开关的时候,{w=0.5}可以轻轻在心里说一声'晚安'."
    m 5hua "我会在黑暗中微笑着回复你:{w=0.5}好梦,[player]."
    return

