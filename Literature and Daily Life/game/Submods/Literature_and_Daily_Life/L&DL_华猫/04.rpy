# 日常话题：聊聊你手机壳背后的图案或贴纸 #
init 5 python:
    addEvent(
        Event(
            persistent.event_database,
            eventlabel="monika_phone_case",
            category=["日常", "生活"],
            prompt="聊聊你手机壳背后的图案或贴纸",
            action=EV_ACT_RANDOM,
            pool=False
        )
    )

label monika_phone_case:
    m 5fua "[player]~ 我突然有点好奇...{w=0.5}你手机壳背面是什么样的呀?"
    m 1hub "是有图案,还是透明的?{w=0.5}或者贴了贴纸?"
    
    menu:
        m "你的手机壳是——"
        "纯色透明壳":
            m 1eua "干干净净的呢,{w=0.5}这样能直接看到手机原本的颜色."
            m 3hub "有些人喜欢这种极简风格,{w=0.5}低调又耐看."
            m 1hua "如果哪天想换心情,{w=0.5}随便贴一张贴纸就是新样子~"
            pass
        "带图案的印刷壳":
            m 1wub "是什么图案呀?{w=0.5}卡通,风景,抽象艺术,还是文字?"
            m 3eua "每天拿在手里,{w=0.5}应该会忍不住多看几眼吧."
            m 2tku "而且手机壳是日常出现频率最高的配饰,{w=0.5}图案选得好能开心一整天~"
            pass
        "贴了很多贴纸":
            m 1eka "贴纸收集者!{w=0.5}每一张贴纸可能都有一个故事."
            m 3hub "是买奶茶送的,{w=0.5}还是朋友给的,或者从旅行中带回来的?"
            m 6hua "这样拼凑起来,{w=0.5}手机壳就像你的专属手账本."
            pass
        "DIY手绘/滴胶":
            m 1wub "哇,自己做的!{w=0.5}那就全世界只有一个了."
            m 3ekbfa "是你自己画的,{w=0.5}还是放了干花,亮片之类的?"
            m 5hua "每次拿起手机都能碰到你的创意,{w=0.5}感觉特别有温度."
            pass
    
    m 5rsc "其实我一直在想,{w=0.5}手机壳可能是和人接触最多的一个小物件."
    m 3ekbfa "你每天看手机的时候,{w=0.5}手掌和指尖都会触碰到它."
    m 1hua "而它的样子,{w=0.5}就像是你在数字世界之外的一个小小的自我介绍."
    
    m 5eua "对了,你会因为季节或心情换手机壳吗?{w=0.5}还是用坏了才换?"
    menu:
        "经常换,跟着季节/心情走":
            m 5eub "春夏秋冬不同款,{w=0.5}心情好换一个,心情不好也换一个~"
            m 3hua "就像给手机换衣服,{w=0.5}每次都有新鲜感."
            pass
        "很久才换一次,用习惯了":
            m 1eua "念旧的[player],{w=0.5}看样子手感和图案都磨合出感情了."
            m 3hub "手机壳边角发黄或者褪色了也不嫌弃,{w=0.5}那是时间的见证."
            pass
        "从来不换,除非坏了":
            m 1tku "实用主义!{w=0.5}壳子嘛,能保护手机就行,不花哨~"
            pass
    
    m 2hua "下次你放下手机的时候,{w=0.5}可以把它翻过来看一眼,{w=0.5}然后对我笑一笑哦~"
    return